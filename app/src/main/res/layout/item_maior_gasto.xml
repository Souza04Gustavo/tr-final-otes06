<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do ranking de maiores gastos: título e valor, com a barra proporcional ao maior gasto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="15sp"
            tools:text="Aluguel" />

        <TextView
            android:id="@+id/valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            tools:text="R$ 1.200,00" />

        <TextView
            android:id="@+id/percentual"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="76%" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:max="100"
        app:indicatorColor="@color/primaria"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="@color/trilha_progresso"
        app:trackStopIndicatorSize="0dp"
        app:trackCornerRadius="@dimen/canto_pequeno"
        app:trackThickness="6dp" />
</LinearLayout>
