<?xml version="1.0" encoding="utf-8"?>
<!-- T4 – Lembretes -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.lembretes.LembretesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Busca por título ou observação -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_busca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_busca"
            app:startIconTint="@color/texto_secundario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_busca_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/busca_lembretes"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtro por categoria -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chip_todos"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_todos"
                    style="@style/Widget.Casaemdia.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_contas"
                    style="@style/Widget.Casaemdia.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_contas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_manutencao"
                    style="@style/Widget.Casaemdia.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_manutencao" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_outros"
                    style="@style/Widget.Casaemdia.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_outros" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Pendentes / Concluídos -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupo_situacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:checkedButton="@id/botao_pendentes"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_pendentes"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/situacao_pendentes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_concluidos"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/situacao_concluidos" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/atualizar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="96dp"
                    tools:listitem="@layout/item_lembrete" />

                <TextView
                    android:id="@+id/vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    android:text="@string/lembretes_vazio_pendentes"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/botao_novo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/acao_novo_lembrete"
        android:src="@drawable/ic_adicionar"
        app:backgroundTint="@color/primaria"
        app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
