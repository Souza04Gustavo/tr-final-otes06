<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de lembrete: filete na cor da categoria (borda esquerda), título, linha com
    CATEGORIA · data · recorrência, status em texto (atrasado / vence hoje), valor e caixa de concluir.
    Sem ícone e sem selo colorido: a categoria é identificada pelo filete E pelo rótulo escrito.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <View
            android:id="@+id/filete"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            tools:background="@color/conta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/texto"
                android:textSize="15sp"
                tools:text="Conta de luz" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/categoria"
                    style="@style/TextAppearance.Casaemdia.RotuloCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Conta" />

                <TextView
                    android:id="@+id/detalhe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text=" · 25/11 · Mensal" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Atrasado há 1 dia"
                tools:textColor="@color/erro"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/texto"
            android:textSize="14sp"
            tools:text="R$ 184,50" />

        <ImageButton
            android:id="@+id/botao_concluir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/bg_circulo_concluir"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
