<?xml version="1.0" encoding="utf-8"?>
<!-- Tela principal: barra superior + abas (Painel, Lembretes, Compras) + navegação inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.main.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingStart="4dp"
        app:titleMarginStart="16dp" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_principal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/contorno_suave" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacao_inferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacao" />
</LinearLayout>
